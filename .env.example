# Collab MCP - modelo de configuracao local.
#
# Copie para `.env` apenas se quiser usar o recurso nativo do Node:
#   node --env-file=.env dist/index.js
# O arquivo `.env` e ignorado pelo Git. `.env.example` NAO deve conter segredos.
#
# O transporte HTTP exige Bearer token. Crie a primeira credencial com:
#   npm.cmd run auth:create -- "Nome / Cliente"
# O token e exibido UMA vez; configure-o no cliente MCP. NUNCA coloque tokens
# neste arquivo, em workspaces.json ou em qualquer arquivo versionado.
#
# O listener continua SOMENTE em loopback. Tailscale Serve (reverse proxy para
# loopback) NAO esta configurado; so habilite apos revisar ALLOWED_HOSTS e
# TRUST_PROXY. Nao abra portas no roteador.

# Host de binding. Por seguranca a aplicacao aceita SOMENTE loopback.
# Valores permitidos: 127.0.0.1 | localhost | ::1
COLLAB_HOST=127.0.0.1

# Porta HTTP. Use 0 para porta efemera (usada pelos testes).
COLLAB_PORT=3100

# Caminho do SQLite. Relativo ao diretorio do projeto; diretorio ignorado pelo Git.
COLLAB_DB_PATH=./data/collab-mcp.sqlite

# Nivel de log: debug | info | warn | error
COLLAB_LOG_LEVEL=info

# Arquivo JSON com os workspaces PERMITIDOS pelo servidor.
# - Default quando omitido: ./workspaces.json
# - Se o arquivo default nao existir, o catalogo sobe VAZIO e create_room recusa.
# - Se voce definir esta variavel e o arquivo nao existir, o startup FALHA.
# - rootPath e lido SOMENTE aqui, nunca por tool remota. O arquivo contem roots
#   reais do host e deve ficar FORA do workspace compartilhado (e no .gitignore).
# - Modelo: workspaces.example.json
# COLLAB_WORKSPACES_FILE=./workspaces.json

# Hosts aceitos no cabecalho Host (sem porta, sem wildcard, separados por virgula).
# Default: 127.0.0.1,localhost,[::1]
# Para Tailscale Serve, adicione SOMENTE o hostname explicito que o proxy envia,
# ex.: COLLAB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],meu-pc.tailnet.ts.net
# COLLAB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Confiar em X-Forwarded-For SOMENTE quando o proxy estiver habilitado e o par
# remoto estiver em COLLAB_TRUSTED_PROXY_IPS. Default: desabilitado (0).
# COLLAB_TRUST_PROXY=0
# COLLAB_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Rate limiting de tentativas Bearer invalidas (por endereco do par, nunca por token).
# COLLAB_AUTH_MAX_FAILURES=5
# COLLAB_AUTH_WINDOW_MS=60000
# COLLAB_AUTH_BLOCK_MS=60000
