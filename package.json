{
  "name": "agent-live-share",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Live Share: an MCP server that coordinates multiple coding agents on one shared workspace with file locks, reviewable patches, and room-based collaboration.",
  "type": "module",
  "license": "MIT",
  "author": "Vinicius Adami Cabral",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciusadami-ux/agent-live-share.git"
  },
  "bugs": {
    "url": "https://github.com/viniciusadami-ux/agent-live-share/issues"
  },
  "homepage": "https://github.com/viniciusadami-ux/agent-live-share#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "multi-agent",
    "collaboration",
    "file-locks",
    "sqlite",
    "typescript",
    "opencode",
    "codex",
    "claude-code"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx tests/integration/smoke.ts",
    "smoke:integration": "tsx tests/integration/smoke.ts",
    "smoke:foundation": "tsx tests/foundation/smoke.ts",
    "auth:create": "tsx src/cli/auth.ts create",
    "auth:list": "tsx src/cli/auth.ts list",
    "auth:revoke": "tsx src/cli/auth.ts revoke",
    "check:mcp": "tsx adapters/scripts/check-mcp-connection.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
